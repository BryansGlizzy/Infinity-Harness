KEV_URL=http://<host>:8888/v1/systemone
KEV_API_KEY=
KEV_MODEL=kev-9b

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_RPM=40
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

EMBEDDINGS_BASE_URL=http://<host>:8889/v1
EMBEDDINGS_MODEL=unsloth/embeddinggemma-2-GGUF
# Defaults to KEV_API_KEY (the Unsloth box uses one key for both)
EMBEDDINGS_API_KEY=
# Vector-only search hits below this cosine similarity are dropped (calibrated for EmbeddingGemma)
# EMBEDDINGS_MIN_SIMILARITY=0.65

# Optional: default model per subscription pool (agents can pick any model the harness offers in Settings), local LLM concurrency, idle session timeout
CLAUDE_MODEL=sonnet
KIMI_MODEL=kimi-code/k3.1-pro
CODEX_MODEL=gpt-6.1-sol
AGY_MODEL=gemini-3.8-flash
LOCAL_LLM_CONCURRENCY=2
IH_IDLE_MINUTES=15

# Optional: API access (see README). The token is generated into .infinity-harness/api-token on first start.
# IH_API_TOKEN=
# IH_REQUIRE_TOKEN=1
# IH_ALLOWED_HOSTS=workbox.lan
# IH_HOST=127.0.0.1

# Optional: run the agy ACP server on your real HOME (loads your Antigravity MCP servers and skills; default isolated)
# IH_AGY_SHARED_HOME=1

# Optional: swarm federation (see README). The port other swarms reach this one on, through an SSH forward. It serves only
# signed /fed routes. A second instance on the same machine needs its own. "off" switches federation off.
# IH_FED_PORT=7422
# IH_FED_POLL_MS=30000
